# Aevum Core — Environment Configuration Template
# Copy this file to .env and configure values as needed.
# NEVER commit the actual .env file with production credentials or API keys.

# Environment Mode: development, test, production
AEVUM_ENV=development

# Core Server Configuration
AEVUM_HOST=127.0.0.1
AEVUM_PORT=8000

# Persistence Layer
# SQLite database path (Async SQLAlchemy URL)
AEVUM_DATABASE_URL=sqlite+aiosqlite:///./aevum.db

# LLM Provider Configuration (Phase 1.3+)
AEVUM_LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Automatic Memory Curation (Phase 3.4)
AEVUM_MEMORY_AUTO_CURATION_ENABLED=false

# Memory Embedding Configuration (Phase 3.6)
AEVUM_EMBEDDING_PROVIDER=gemini
AEVUM_EMBEDDING_MODEL=text-embedding-004


