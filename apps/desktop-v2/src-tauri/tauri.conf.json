{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aevum",
  "version": "0.1.0",
  "identifier": "com.aevum.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Aevum",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["aevum"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}
